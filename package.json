{
  "type": "module",
  "private": true,
  "version": "1.0.0",
  "scripts": {
    "examine": "deno lint ./src && deno check ./src && deno test ./src",
    "prepack": "deno x glace ./www --out=./out",
    "produce": "deno x glace ./www --out=./out & deno -RNE ./src/mods/srv/bin.ts",
    "develop": "deno x glace ./www --out=./out --watch=./src,./www --dev & deno -RNE ./src/mods/srv/bin.ts --dev"
  },
  "files": [
    "./out"
  ],
  "dependencies": {
    "@hazae41/immutable": "^2.1.5",
    "@hazae41/labase": "^1.0.33",
    "@hazae41/rewind": "^2.3.12",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@hazae41/glace": "^1.0.36",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "deno": "^2.9.6"
  }
}